{
  "name": "scodex-workbench",
  "version": "1.3.21",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1 --port 4178\" \"wait-on http://127.0.0.1:4178 && electron .\"",
    "build": "node scripts/generate-licenses.cjs && vite build",
    "test": "node --test tests/*.test.mjs",
    "smoke": "node tests/smoke.cjs",
    "dist": "npm run test && npm run build && electron-builder --win portable --x64 && npm run smoke"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.3.3",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@uiw/react-codemirror": "^4.25.4",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.577.0",
    "pdfjs-dist": "5.4.624",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "saxes": "5.0.1",
    "word-extractor": "1.0.4",
    "yauzl": "3.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "vite": "^7.3.1",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "online.catbee.scodex.workbench",
    "productName": "Scodex工作台",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/workspace-tools-bundle",
        "to": "workspace-tools",
        "filter": [
          "node.zip",
          "python.zip",
          "pip.zip"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Scodex-Workbench-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Scodex-Workbench-${version}-${arch}.${ext}"
    },
    "asar": true
  }
}
